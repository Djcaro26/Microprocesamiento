#include <xc.h>
#include <stdio.h>

#define _XTAL_FREQ 4000000

#pragma config FOSC = INTRC_NOCLKOUT
#pragma config WDTE = OFF
#pragma config PWRTE = ON
#pragma config MCLRE = OFF
#pragma config CP = OFF
#pragma config CPD = OFF
#pragma config BOREN = OFF
#pragma config IESO = OFF
#pragma config FCMEN = OFF
#pragma config LVP = OFF

//================ LCD =================

#define RS RD0
#define EN RD1

//================ FUNCIONES =================

void lcd_cmd(unsigned char);
void lcd_data(unsigned char);
void lcd_init();
void lcd_clear();
void lcd_string(char *);
void lcd_goto(unsigned char, unsigned char);

char keypad();

void beep();

void sirena_reset();

unsigned int leerADC();

void servo_abrir();

void servo_cerrar();

//================ VARIABLES =================

char clave[7];

char ingreso[7];

char tecla;

unsigned char i;

unsigned char intentos = 3;

unsigned char clave_guardada = 0;

unsigned char bloqueo_sabotaje = 0;

//================ LCD =================

void lcd_cmd(unsigned char cmd)
{
    RS = 0;

    PORTD = (PORTD & 0x0F) | (cmd & 0xF0);

    EN = 1;
    __delay_us(50);
    EN = 0;

    PORTD = (PORTD & 0x0F) | ((cmd << 4) & 0xF0);

    EN = 1;
    __delay_us(50);
    EN = 0;
}

void lcd_data(unsigned char data)
{
    RS = 1;

    PORTD = (PORTD & 0x0F) | (data & 0xF0);

    EN = 1;
    __delay_us(50);
    EN = 0;

    PORTD = (PORTD & 0x0F) | ((data << 4) & 0xF0);

    EN = 1;
    __delay_us(50);
    EN = 0;
}

void lcd_init()
{
    __delay_ms(20);

    lcd_cmd(0x02);
    lcd_cmd(0x28);
    lcd_cmd(0x0C);
    lcd_cmd(0x06);
    lcd_cmd(0x01);
}

void lcd_clear()
{
    lcd_cmd(0x01);

    __delay_ms(2);
}

void lcd_string(char *str)
{
    while(*str)
    {
        lcd_data(*str++);
    }
}

void lcd_goto(unsigned char x, unsigned char y)
{
    unsigned char pos;

    if(y == 1)
        pos = 0x80 + x;
    else
        pos = 0xC0 + x;

    lcd_cmd(pos);
}

//================ ADC =================

unsigned int leerADC()
{
    __delay_us(50);

    GO_nDONE = 1;

    while(GO_nDONE);

    return ((ADRESH << 8) + ADRESL);
}

//================ KEYPAD =================

char keypad()
{
    RB4 = 0; RB5 = 1; RB6 = 1; RB7 = 1;

    if(RB0 == 0){__delay_ms(15); while(RB0==0); return '1';}
    if(RB1 == 0){__delay_ms(15); while(RB1==0); return '2';}
    if(RB2 == 0){__delay_ms(15); while(RB2==0); return '3';}

    RB4 = 1; RB5 = 0; RB6 = 1; RB7 = 1;

    if(RB0 == 0){__delay_ms(15); while(RB0==0); return '4';}
    if(RB1 == 0){__delay_ms(15); while(RB1==0); return '5';}
    if(RB2 == 0){__delay_ms(15); while(RB2==0); return '6';}

    RB4 = 1; RB5 = 1; RB6 = 0; RB7 = 1;

    if(RB0 == 0){__delay_ms(15); while(RB0==0); return '7';}
    if(RB1 == 0){__delay_ms(15); while(RB1==0); return '8';}
    if(RB2 == 0){__delay_ms(15); while(RB2==0); return '9';}

    RB4 = 1; RB5 = 1; RB6 = 1; RB7 = 0;

    if(RB0 == 0){__delay_ms(15); while(RB0==0); return '*';}
    if(RB1 == 0){__delay_ms(15); while(RB1==0); return '0';}
    if(RB2 == 0){__delay_ms(15); while(RB2==0); return '#';}

    return 0;
}

//================ BEEP =================

void beep()
{
    unsigned char j;

    for(j=0; j<8; j++)
    {
        RC5 = 1;

        __delay_us(180);

        RC5 = 0;

        __delay_us(180);
    }
}

//================ SERVO =================

void servo_abrir()
{
    unsigned char s;

    for(s=0; s<50; s++)
    {
        RE1 = 1;

        // 180 GRADOS

        __delay_us(2400);

        RE1 = 0;

        __delay_us(17600);
    }
}

void servo_cerrar()
{
    unsigned char s;

    for(s=0; s<50; s++)
    {
        RE1 = 1;

        // 0 GRADOS

        __delay_us(1000);

        RE1 = 0;

        __delay_us(19000);
    }
}

//================ SIRENA =================

void sirena_reset()
{
    unsigned int j;

    char t;

    lcd_clear();

    lcd_string("ALERTA SABOTAJE");

    while(1)
    {
        for(j=0; j<250; j++)
        {
            RC5 = 1;

            __delay_us(70);

            RC5 = 0;

            __delay_us(70);
        }

        for(j=0; j<250; j++)
        {
            RC5 = 1;

            __delay_us(180);

            RC5 = 0;

            __delay_us(180);
        }

        t = keypad();

        if(t == '*')
        {
            if(leerADC() > 250)
            {
                RC5 = 0;

                intentos = 3;

                RC2 = 1;
                RC3 = 1;
                RC4 = 1;

                lcd_clear();

                lcd_string("ALARMA OFF");

                __delay_ms(1000);

                lcd_clear();

                lcd_string("INGRESE CLAVE");

                lcd_goto(0,2);

                break;
            }
        }
    }
}

//================ MAIN =================

void main()
{
    ANSEL = 0b00000010;

    ANSELH = 0;

    ADCON0 = 0b00000101;

    ADCON1 = 0b10000000;

    CM1CON0 = 0;

    CM2CON0 = 0;

    OPTION_REGbits.nRBPU = 0;

    TRISA = 0x02;

    TRISB = 0b00000111;

    TRISC = 0x00;

    TRISD = 0x00;

    TRISE = 0x00;

    PORTA = 0x00;

    PORTB = 0x07;

    PORTC = 0x00;

    PORTD = 0x00;

    PORTE = 0x00;

    //================ TELEGRAM =================

    RC6 = 0;

    RC1 = 0;

    RC0 = 0;

    RC7 = 0;

    RE0 = 0;

    RE1 = 0;

    //================ LEDS =================

    RC2 = 0;
    RC3 = 0;
    RC4 = 0;

    lcd_init();

    servo_cerrar();

    while(1)
    {
        if(clave_guardada == 1)
        {
            if(leerADC() < 250)
            {
                bloqueo_sabotaje = 1;

                RC6 = 1;

                __delay_ms(300);

                RC6 = 0;

                sirena_reset();

                bloqueo_sabotaje = 0;
            }
        }

        if(clave_guardada == 0)
        {
            lcd_clear();

            lcd_string("CREAR CLAVE");

            lcd_goto(0,2);

            i = 0;

            while(1)
            {
                tecla = keypad();

                if(tecla != 0)
                {
                    beep();

                    if(tecla >= '0' && tecla <= '9')
                    {
                        if(i < 6)
                        {
                            clave[i] = tecla;

                            lcd_data('*');

                            i++;
                        }
                    }

                    if(tecla == '#')
                    {
                        if(i == 6)
                        {
                            clave[6] = '\0';

                            clave_guardada = 1;

                            RE0 = 1;

                            __delay_ms(300);

                            RE0 = 0;

                            lcd_clear();

                            lcd_string("CLAVE GUARDADA");

                            __delay_ms(1000);

                            break;
                        }
                    }
                }
            }
        }

        lcd_clear();

        lcd_string("INGRESE CLAVE");

        lcd_goto(0,2);

        RC2 = 1;
        RC3 = 1;
        RC4 = 1;

        i = 0;

        while(1)
        {
            if(clave_guardada == 1)
            {
                if(leerADC() < 250)
                {
                    bloqueo_sabotaje = 1;

                    RC6 = 1;

                    __delay_ms(300);

                    RC6 = 0;

                    sirena_reset();

                    bloqueo_sabotaje = 0;

                    lcd_clear();

                    lcd_string("INGRESE CLAVE");

                    lcd_goto(0,2);

                    RC2 = 1;
                    RC3 = 1;
                    RC4 = 1;

                    i = 0;
                }
            }

            tecla = keypad();

            if(tecla != 0)
            {
                beep();

                if(tecla >= '0' && tecla <= '9')
                {
                    if(i < 6)
                    {
                        ingreso[i] = tecla;

                        lcd_data('*');

                        i++;
                    }
                }

                if(tecla == '*')
                {
                    if(
                       ingreso[0]=='0' &&
                       ingreso[1]=='7' &&
                       ingreso[2]=='0' &&
                       ingreso[3]=='1' &&
                       ingreso[4]=='0' &&
                       ingreso[5]=='5'
                      )
                    {
                        clave_guardada = 0;

                        intentos = 3;

                        RC2 = 0;
                        RC3 = 0;
                        RC4 = 0;

                        lcd_clear();

                        lcd_string("MODO CONFIG");

                        __delay_ms(1000);

                        break;
                    }
                }

                if(tecla == '#')
                {
                    if(i == 6)
                    {
                        ingreso[6] = '\0';

                        if(
                            bloqueo_sabotaje == 0 &&

                            ingreso[0] == clave[0] &&
                            ingreso[1] == clave[1] &&
                            ingreso[2] == clave[2] &&
                            ingreso[3] == clave[3] &&
                            ingreso[4] == clave[4] &&
                            ingreso[5] == clave[5]
                          )
                        {
                            RC2 = 0;
                            RC3 = 0;
                            RC4 = 0;

                            RC1 = 1;

                            __delay_ms(300);

                            RC1 = 0;

                            servo_abrir();

                            lcd_clear();

                            lcd_string("ACCESO EXITOSO");

                            __delay_ms(1000);

                            intentos = 3;

                            while(1)
                            {
                                tecla = keypad();

                                if(tecla != 0)
                                {
                                    beep();

                                    if(tecla == '*')
                                    {
                                        RC7 = 1;

                                        __delay_ms(300);

                                        RC7 = 0;

                                        servo_cerrar();

                                        lcd_clear();

                                        lcd_string("CAJA CERRADA");

                                        __delay_ms(1000);

                                        lcd_clear();

                                        lcd_string("INGRESE CLAVE");

                                        lcd_goto(0,2);

                                        RC2 = 1;
                                        RC3 = 1;
                                        RC4 = 1;

                                        i = 0;

                                        break;
                                    }
                                }
                            }
                        }

                        else
                        {
                            intentos--;

                            lcd_clear();

                            lcd_string("CLAVE INVALIDA");

                            __delay_ms(1000);

                            if(intentos == 2)
                                RC4 = 0;

                            if(intentos == 1)
                                RC3 = 0;

                            if(intentos == 0)
                            {
                                RC2 = 0;

                                RC0 = 1;

                                __delay_ms(300);

                                RC0 = 0;

                                sirena_reset();
                            }

                            lcd_clear();

                            lcd_string("INGRESE CLAVE");

                            lcd_goto(0,2);

                            i = 0;
                        }
                    }
                }
            }
        }
    }
}
