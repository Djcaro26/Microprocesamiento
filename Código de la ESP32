//================ TELEGRAM =================

void enviarTelegram(String mensaje)
{
  HTTPClient http;

  mensaje.replace(" ", "%20");

  mensaje.replace("\n", "%0A");

  String url =
    "https://api.telegram.org/bot" +
    BOTtoken +
    "/sendMessage?chat_id=" +
    chat_id +
    "&text=" +
    mensaje;

  http.begin(url);

  int httpCode = http.GET();

  Serial.print("HTTP: ");

  Serial.println(httpCode);

  http.end();
}

//================ FECHA Y HORA =================

String obtenerHora()
{
  struct tm timeinfo;

  if(!getLocalTime(&timeinfo))
  {
    return "No disponible";
  }

  char fechaHora[120];

  char dias[7][12] = {
    "Domingo",
    "Lunes",
    "Martes",
    "Miercoles",
    "Jueves",
    "Viernes",
    "Sabado"
  };

  char meses[12][12] = {
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre"
  };

  sprintf(
    fechaHora,
    "%s %02d de %s del %04d - %02d:%02d:%02d",
    dias[timeinfo.tm_wday],
    timeinfo.tm_mday,
    meses[timeinfo.tm_mon],
    timeinfo.tm_year + 1900,
    timeinfo.tm_hour,
    timeinfo.tm_min,
    timeinfo.tm_sec
  );

  return String(fechaHora);
}

