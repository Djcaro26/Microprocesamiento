  pinMode(INTENTOS_PIN, INPUT_PULLDOWN);

  pinMode(CERRADA_PIN, INPUT_PULLDOWN);

  pinMode(CAMBIO_PIN, INPUT_PULLDOWN);

  //================ MEMORIA =================

  preferences.begin("cajafuerte", false);

  contadorAccesos = preferences.getInt("contador", 0);

  //================ WIFI =================

  WiFi.begin(ssid, password);

  Serial.print("Conectando WiFi");

  while(WiFi.status() != WL_CONNECTED)
