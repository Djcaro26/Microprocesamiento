      enviarTelegram(mensaje);

      enviadaCajaCerrada = true;
    }
  }
  else
  {
    enviadaCajaCerrada = false;
  }

  //=================================================
  // CONTRASEÑA CAMBIADA
  //=================================================

  if(cambio == HIGH)
  {
    if(enviadoCambio == false)
    {
      String mensaje;

      mensaje = "🔑 CONTRASEÑA CAMBIADA\n\n";

      mensaje += "La clave de la caja fuerte fue modificada\n\n";

      mensaje += "Fecha y hora:\n";

      mensaje += obtenerHora();

      enviarTelegram(mensaje);

      enviadoCambio = true;
    }
  }
  else
